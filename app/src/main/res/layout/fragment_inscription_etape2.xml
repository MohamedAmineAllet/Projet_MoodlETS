<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mon numéro de téléphone"
        android:textSize="13sp"
        android:textColor="#1A1A2E"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/etTelephone"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_background"
        android:hint="Entre ton numéro de téléphone"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:inputType="phone"
        android:textSize="14sp"
        android:layout_marginBottom="14dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Crée mot de passe"
        android:textSize="13sp"
        android:textColor="#1A1A2E"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_background"
        android:hint="Entre un mot de passe"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:inputType="textPassword"
        android:textSize="14sp"
        android:layout_marginBottom="14dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mon adresse courriel"
        android:textSize="13sp"
        android:textColor="#1A1A2E"
        android:layout_marginBottom="6dp"/>

    <EditText
        android:id="@+id/etEmailConfirm"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/input_background"
        android:hint="Confirme ton adresse courriel"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:inputType="textEmailAddress"
        android:textSize="14sp"
        android:layout_marginBottom="20dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btnPrecedent"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="← Précédent"
            android:textColor="#1A1A2E"
            android:backgroundTint="#E0DFEF"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginEnd="8dp"
            style="@style/Widget.MaterialComponents.Button"/>

        <Button
            android:id="@+id/btnSuivant"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Suivant →"
            android:textColor="#1A1A2E"
            android:backgroundTint="#F5E6C8"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            style="@style/Widget.MaterialComponents.Button"/>

    </LinearLayout>

</LinearLayout>