<?xml version="1.0" encoding="utf-8"?>
    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/BG">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toStartOf="@+id/guideline22"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/guideline12"
            app:layout_constraintTop_toTopOf="@+id/guideline27"
            tools:ignore="TextSizeCheck">

            <TextView
                android:id="@+id/textView9"
                android:layout_width="wrap_content"
                android:layout_height="14dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/description"
                android:textColor="@color/Carbon_70"
                android:textSize="12sp"
                tools:ignore="TextSizeCheck" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_weight="0"
                tools:ignore="InefficientWeight" />

            <TextView
                android:id="@+id/txt_Description_Travail_Details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins"
                android:text="@string/d_tails"
                android:textColor="@color/Carbon_70"
                android:textSize="12sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="12dp" />

            <TextView
                android:id="@+id/textView15"
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/instructions"
                android:textColor="@color/Carbon_70"
                android:textSize="12sp"
                tools:ignore="TextSizeCheck" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_weight="0"
                tools:ignore="InefficientWeight" />

            <TextView
                android:id="@+id/txt_Instructions_Travaux_Details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/instructions_Travai_Details"
                android:textColor="@color/Carbon_70"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="24dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline22"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="24dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline23"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="88dp" />

        <ImageButton
            android:id="@+id/btnRondFlecheGauche_Travail_details"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/button_rond_fleche_gauche"
            android:elevation="8dp"
            app:layout_constraintStart_toStartOf="@+id/guideline12"
            app:layout_constraintTop_toTopOf="@+id/guideline23"
            app:srcCompat="@drawable/fleche_gauche"
            tools:ignore="ContentDescription,SpeakableTextPresentCheck" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/img_profil_travail_details"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:color/darker_gray"
            app:layout_constraintEnd_toStartOf="@+id/guideline22"
            app:layout_constraintTop_toTopOf="@+id/guideline23"
            tools:ignore="ImageContrastCheck" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline24"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="168dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@+id/guideline22"
            app:layout_constraintStart_toStartOf="@+id/guideline12"
            app:layout_constraintTop_toTopOf="@+id/guideline24">

            <ImageView
                android:id="@+id/imageView6"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:srcCompat="@drawable/icone_travail_lilac"
                tools:ignore="ContentDescription,ImageContrastCheck" />

            <Space
                android:layout_width="16dp"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_Nom_Travail_Details"
                    android:layout_width="wrap_content"
                    android:layout_height="22dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/nom_du_travail_details"
                    android:textColor="@color/Carbon"
                    android:textSize="20sp"
                    tools:ignore="TextSizeCheck" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="4dp" />

                <TextView
                    android:id="@+id/txt_Cours_travail_Details"
                    android:layout_width="match_parent"
                    android:layout_height="14dp"
                    android:fontFamily="@font/poppins"
                    android:text="@string/nom_du_cours_travail"
                    android:textColor="@color/Carbon_70"
                    android:textSize="12sp"
                    tools:ignore="TextSizeCheck" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txt_statut_travail_details"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/statut_travail_details"
                        android:elevation="4dp"
                        android:fontFamily="@font/poppins"
                        android:paddingLeft="10dp"
                        android:paddingTop="4dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="4dp"
                        android:text="@string/statut_travail_details"
                        android:textSize="12sp"
                        tools:ignore="TextSizeCheck,VisualLintBounds" />

                    <Space
                        android:layout_width="16dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0"
                        tools:ignore="InefficientWeight" />

                    <TextView
                        android:id="@+id/txt_type_travail_details"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/statut_travail_details"
                        android:elevation="4dp"
                        android:fontFamily="@font/poppins"
                        android:paddingLeft="10dp"
                        android:paddingTop="4dp"
                        android:paddingRight="10dp"
                        android:paddingBottom="4dp"
                        android:text="@string/type_travail"
                        android:textSize="12sp"
                        tools:ignore="TextSizeCheck,VisualLintBounds" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline25"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="272dp" />

        <TextView
            android:id="@+id/textView7"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/g_n_ralit_s"
            android:textColor="@color/Carbon"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="@+id/guideline12"
            app:layout_constraintTop_toTopOf="@+id/guideline25"
            tools:ignore="TextSizeCheck" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline26"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="306dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="16dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@+id/guideline22"
            app:layout_constraintStart_toStartOf="@+id/guideline12"
            app:layout_constraintTop_toTopOf="@+id/guideline26"
            tools:ignore="TextSizeCheck">

            <TextView
                android:id="@+id/textView13"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/date_limite_travail_details"
                android:textColor="@color/Carbon_70"
                android:textSize="12sp" />

            <Space
                android:layout_width="6dp"
                android:layout_height="14dp"
                android:layout_weight="0"
                tools:ignore="InefficientWeight" />

            <TextView
                android:id="@+id/txt_Date_Limite_Travail_Details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:fontFamily="@font/poppins"
                android:text="@string/date"
                android:textColor="@color/Carbon_70"
                android:textSize="12sp" />

        </LinearLayout>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline27"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="334dp" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline28"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="462dp" />

        <TextView
            android:id="@+id/textView17"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Votre note"
            android:textColor="@color/Carbon"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="@+id/guideline12"
            app:layout_constraintTop_toTopOf="@+id/guideline28" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline29"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="493dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="160dp"
            android:background="@drawable/fond_blanc"
            app:layout_constraintEnd_toStartOf="@+id/guideline22"
            app:layout_constraintStart_toStartOf="@+id/guideline12"
            app:layout_constraintTop_toTopOf="@+id/guideline29">

            <ProgressBar
                android:id="@+id/progressBar2"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:indeterminate="false"
                android:indeterminateTint="#46AAA2"
                android:max="100"
                android:progress="70"
                android:progressDrawable="@drawable/cercle_note"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txt_note_resultat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="70%"
                android:textColor="@color/Carbon"
                android:textSize="28sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline30"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="688dp" />

        <TextView
            android:id="@+id/textView19"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="Commentaires"
            android:textColor="@color/Carbon"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="@+id/guideline12"
            app:layout_constraintTop_toTopOf="@+id/guideline30" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline31"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="722dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="144dp"
            android:background="@drawable/fond_blanc"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingRight="12dp"
            app:layout_constraintEnd_toStartOf="@+id/guideline22"
            app:layout_constraintStart_toStartOf="@+id/guideline12"
            app:layout_constraintTop_toTopOf="@+id/guideline31">

            <TextView
                android:id="@+id/txt_Correction_Titre"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="Correction"
                android:textColor="@color/Carbon"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:orientation="horizontal"
                tools:layout_editor_absoluteX="-14dp"
                tools:layout_editor_absoluteY="37dp">

                <ImageView
                    android:id="@+id/imageView7"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    app:srcCompat="@drawable/user" />

                <Space
                    android:layout_width="4dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0" />

                <TextView
                    android:id="@+id/txt_prof_travail_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:fontFamily="@font/poppins"
                    android:text="Lazhar Khelifi"
                    android:textColor="@color/Carbon_70"
                    android:textSize="12sp" />

            </LinearLayout>

            <Space
                android:layout_width="wrap_content"
                android:layout_height="8dp"
                android:layout_weight="0" />

            <TextView
                android:id="@+id/textView5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:fontFamily="@font/poppins_light"
                android:text="Lorem ipsum"
                android:textColor="@color/Carbon_70"
                android:textSize="12sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>