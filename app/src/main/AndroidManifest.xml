<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Projet_MoodlETS"
        android:usesCleartextTraffic="true">

        <!-- Écran de démarrage -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login -->
        <activity
            android:name=".activities.ConnexionActivity"
            android:exported="false" />

        <!-- Inscription -->
        <activity
            android:name=".activities.InscriptionActivity"
            android:exported="false" />

        <!-- Détails cours -->
        <activity
            android:name=".activities.CoursDetails"
            android:exported="false" />

        <!-- Mes cours -->
        <activity
            android:name=".activities.MesCoursActivity"
            android:exported="false" />

        <!-- Mes travaux -->
        <activity
            android:name=".activities.MesTravauxActivity"
            android:exported="false" />

        <!-- Détails travaux -->
        <activity
            android:name=".activities.TravailDetailsRemisActivity"
            android:exported="false" />

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />

    </application>

</manifest>